<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="style_button">
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="style_popup_button">
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/style_popup_button</item>
        <item name="android:fontFamily">font/roboto_light</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>