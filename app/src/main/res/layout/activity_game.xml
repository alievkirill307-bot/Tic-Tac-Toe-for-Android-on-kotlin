<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    tools:context=".GameActivity">

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/roboto_bold"
        android:textColor="#180000"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/toGameClose"
        app:layout_constraintEnd_toStartOf="@+id/toPopupMenu"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toEndOf="@+id/toGameClose"
        app:layout_constraintTop_toTopOf="@+id/toGameClose"
        app:layout_constraintVertical_bias="0.75" />

    <ImageView
        android:id="@+id/toGameClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/style_menu_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cross"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/toPopupMenu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/style_menu_button"
        android:backgroundTint="@color/blue"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/menu"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/cell_18"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cell_19"
        app:layout_constraintStart_toEndOf="@+id/cell_17"
        app:layout_constraintTop_toBottomOf="@+id/cell_15"
        app:layout_constraintVertical_bias="0.0"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView
        android:id="@+id/cell_11"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/cell_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toGameClose"
        tools:srcCompat="@drawable/cross"
        android:background="@drawable/style_gamefield"

        />

    <ImageView
        android:id="@+id/cell_16"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cell_15"
        app:layout_constraintTop_toBottomOf="@+id/cell_13"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView
        android:id="@+id/cell_14"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/cell_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cell_11"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView
        android:id="@+id/cell_17"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cell_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cell_14"
        app:layout_constraintVertical_bias="0.0"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView

        android:id="@+id/cell_12"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/cell_13"
        app:layout_constraintStart_toEndOf="@+id/cell_11"
        app:layout_constraintTop_toBottomOf="@+id/toGameClose"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView
        android:id="@+id/cell_15"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/cell_16"
        app:layout_constraintStart_toEndOf="@+id/cell_14"
        app:layout_constraintTop_toBottomOf="@+id/cell_12"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView
        android:id="@+id/cell_13"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cell_12"
        app:layout_constraintTop_toBottomOf="@+id/toGameClose"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />

    <ImageView
        android:id="@+id/cell_19"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cell_18"
        app:layout_constraintTop_toBottomOf="@+id/cell_16"
        app:layout_constraintVertical_bias="0.0"
        android:background="@drawable/style_gamefield"
        tools:srcCompat="@drawable/cross" />
</androidx.constraintlayout.widget.ConstraintLayout>